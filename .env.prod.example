# Production Environment Configuration
# Copy this file to .env.prod and update with your settings

# Server Configuration
NODE_ENV=production
PORT=3001

# State backend: ain-store (AIN Store; see docs/AIN-STORE-STATE.md) or ain-blockchain (encrypted chain records)
STATE_BACKEND=ain-blockchain
# For ain-store: private JSON file { url, app, chainId, writerKey, serviceToken }
AIN_STORE_CONFIG=
AIN_STATE_CONFIG=/run/ain/state-config.json
# Optional: memory budget for decrypted state records (bytes, default 33554432 = 32MB)
AIN_STATE_CACHE_MAX_BYTES=

# LLM API URL (vLLM chat completions endpoint)
LLM_API_URL=https://your-production-llm-server:8000/v1/chat/completions

# LLM Model path
# Example: /data/models/gpt-oss-120b
LLM_MODEL=/path/to/your/model

# SSL Configuration
# WARNING: Set to 1 or remove this line for production!
# Only use 0 if your LLM server has self-signed certificates
# NODE_TLS_REJECT_UNAUTHORIZED=0

# CORS Configuration
# Specify your production frontend URLs
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Ingest Configuration (EPIC8 — ainspace dual-write)
# Shared secret for POST /api/ingest/conversation (Authorization: Bearer <token>).
# Distribute this token ONLY to the ainspace frontend/BFF. If unset, the ingest
# endpoint is DISABLED (503) — fail closed.
INGEST_TOKEN=
